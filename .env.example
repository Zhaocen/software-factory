# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# OpenAI 兼容服务的全局 API Key（Ollama 本地服务填 "ollama" 即可；
# 也可在 config.yaml 的 agent 配置中通过 api_key 字段单独覆盖）
OPENAI_COMPATIBLE_API_KEY=

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 配置文件路径（可选）
CONFIG_YAML_PATH=config.yaml

# MySQL 数据库配置
# Docker Compose 启动时 DB_HOST 会被自动覆盖为 mysql 服务名，无需修改
# 本地直连时保持 localhost
PROJECTS_DIR=./projects   # 项目生成文件的宿主机路径，容器内固定映射到 /app/projects
DB_HOST=localhost
DB_PORT=3306
DB_USER=forge          # 不要设为 root，MySQL 镜像会自动创建此账号
DB_PASSWORD=forgepwd   # 同时作为 MYSQL_ROOT_PASSWORD 和应用账号密码
DB_NAME=software_factory
MYSQL_DATA_DIR=./data/mysql   # MySQL 数据目录（宿主机路径），默认相对于 docker-compose.yml
